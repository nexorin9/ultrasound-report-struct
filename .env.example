# 超声报告结构化系统 · 环境变量样例
#
# 凭据一律从环境变量读，**不写进 config.toml**（启动自检会拒绝配置文件里的密钥）。
# 本文件只列变量名与用途，**不含任何真实值**。
#
# 用法：cp .env.example .env，按院内实际填写后由运维注入到进程环境
#      （systemd 的 EnvironmentFile=、容器 secret、或 CI secret 均可）。

# --- 出站读：院内 RIS（历史报告权威）---
# RIS_BASE_URL 覆盖 config.toml 里的 [outbound].ris_base_url
RIS_BASE_URL=https://ris.example-hospital.internal
# RIS_API_TOKEN 出站读用的 Bearer token
RIS_API_TOKEN=

# --- 出站写：院内 EMR（结构化报告落点）---
# EMR_BASE_URL 覆盖 config.toml 里的 [outbound].emr_base_url
EMR_BASE_URL=https://emr.example-hospital.internal
# EMR_API_TOKEN 出站写用的 Bearer token
EMR_API_TOKEN=

# --- 出站推：企业微信群机器人 ---
# WECOM_WEBHOOK_URL 群机器人 webhook 地址
WECOM_WEBHOOK_URL=

# --- 入站回执：内置确认端点鉴权 ---
# DAEMON_API_TOKEN 医师确认回执端点的 Bearer token
DAEMON_API_TOKEN=

# --- 运行期状态库路径（可选）---
# DAEMON_STATE_DB 覆盖 config.toml 里的 [state].db
DAEMON_STATE_DB=data/state.sqlite
